
APP_NAME=Lab-Pocket
ENVIRONMENT=local

PRIMARY_API_KEY=
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_MODEL=gpt-4o-mini

FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=

TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=0.25
LLM_MAX_OUTPUT_TOKENS=700

# USD per million tokens. Set these to the current prices for your models.
PRIMARY_INPUT_COST_PER_MILLION=0
PRIMARY_OUTPUT_COST_PER_MILLION=0
FALLBACK_INPUT_COST_PER_MILLION=0
FALLBACK_OUTPUT_COST_PER_MILLION=0

COST_LOG_PATH=data/cost_log.jsonl
